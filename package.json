    "typography",
    "css",
    "3d",
    "ai-agent"
  ],
  "homepage": "https://github.com/ridelink0/ultimate-frontend-skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ridelink0/ultimate-frontend-skills.git"
  },
  "bugs": "https://github.com/ridelink0/ultimate-frontend-skills/issues",
